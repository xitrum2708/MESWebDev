<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteCapacityLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title text-danger" id="deleteCapacityLabel"><i class="bi bi-exclamation-triangle me-2"></i>Confirm deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Delete <strong id="capacityDeleteCount">0</strong> selected production capacity record(s)?</p>
                @* <p class="text-muted small mb-0 mt-2">These records will be marked inactive if your service implements soft delete.</p> *@
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" id="confirmDeleteCapacity"><i class="bi bi-trash3 me-1"></i>Delete</button>
            </div>
        </div>
    </div>
</div>
