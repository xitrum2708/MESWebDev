@using MESWebDev.Common
@using MESWebDev.Models.IQC.VM
@using MESWebDev.Models.PE
@using MESWebDev.Models.ProdPlan
@using MESWebDev.Services
@using System.Data
@using System.Linq
@inject ITranslationService TranslationService
@model PEViewModel

@{
    var languageCode = Context.Session.GetString("LanguageCode") ?? "vi";
    ViewData["Title"] = TranslationService.GetTranslation("MenuManagement", languageCode);
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var rows = Model?.data?.AsEnumerable().ToList() ?? new List<DataRow>();
}

@section ContentHeader {
    @await Html.PartialAsync("_Breadcrumb", ViewBag.Breadcrumbs as List<MESWebDev.DTO.BreadcrumbItemDto>)
}

<link rel="stylesheet" href="~/css/prod-capacity.css" asp-append-version="true" />



<div class="app-content" id="prodCapacityPage"
     data-url-index="@Url.Action("ProdCapacity", "PE")"
     data-url-search="@Url.Action("ProdCapacitySearch", "PE")"
     data-url-filters="@Url.Action("GetProdCapacityFilterOptions", "PE")"
     data-url-export="@Url.Action("ExportProdCapacityExcel", "PE")"
     data-url-delete="@Url.Action("DeleteProdCapacity", "PE")"
     data-url-detail="@Url.Action("GetProdCapacityDetail", "PE")"
     data-url-upload="@Url.Action("UploadProdCapacity", "PE")"
     data-url-add="@Url.Action("AddProdCapacity", "PE")"
     data-url-edit="@Url.Action("EditProdCapacity", "PE")">

    <div class="container-fluid">

        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <!-- Header -->
                    <div class="card-header">
                        <div class="float-start d-flex justify-content-center align-items-center">
                            <h3 class="card-title fw-bold fs-5 me-3">
                                <i class="bi bi-speedometer2 me-2"></i>
                                Production Capacity
                            </h3>
                            @* Manual_PEProdCapacity.xlsx *@
                            <a class="btn btn-sm btn-light" href="~/Manual/Manual_PEProdCapacity.xlsx">
                                <i class="bi bi-question-circle"></i>
                            </a>
                        </div>

                        <div class="float-end d-flex flex-wrap align-items-center gap-2">

                            <button type="button"
                                    id="btnCapacitySearch"
                                    class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-search me-1"></i>Search
                            </button>

                            <button type="button"
                                    id="btnCapacityUpload"
                                    class="btn btn-info btn-sm">
                                <i class="bi bi-cloud-arrow-up me-1"></i>Upload
                            </button>

                            <button type="button"
                                    id="btnCapacityAdd"
                                    class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-circle me-1"></i>Add
                            </button>

                            <button type="button"
                                    id="btnCapacityDelete"
                                    class="btn btn-danger btn-sm">
                                <i class="bi bi-trash3 me-1"></i>Delete
                                <span id="selectedCapacityCount"
                                      class="badge text-bg-light ms-1">0</span>
                            </button>

                            <button type="button"
                                    id="btnCapacityExport"
                                    class="btn btn-secondary btn-sm">
                                <i class="bi bi-download"></i>
                                Download
                            </button>

                        </div>
                    </div>

                    <!-- Body -->

                    <div class="card-body">

                        <!-- Success / Error Message -->
                        <div id="capacityMessage"
                                class="alert py-2 d-none"
                                role="alert">
                        </div>

                        <!-- Result -->
                        <div id="ResultArea" class="result-area">
                            <partial name="ProdCapacity/_Result"
                                        model="rows" />
                        </div>

                    </div>

                    <!-- Pagination -->
                    <div class="card-footer pager p-0"
                         id="prodCapacityPager"
                         style="@(rows.Count == 0 ? "display:none" : "")">

                        <partial name="_PagingPartialView" />

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div id="capacitySearchArea"></div>

<partial name="ProdCapacity/_Upload" />
<partial name="ProdCapacity/_Delete" />
<partial name="ProdCapacity/_Add"
         model="@(Model?.prodCapacity ?? new ProdCapacityModel())" />

<div id="capacityEditArea"></div>

@section Scripts {
    <link href="~/css/pecss.css" rel="stylesheet" />
    <link href="~/css/bootstrap-icons.min.css" rel="stylesheet" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/loadingpage.js" asp-append-version="true"></script>
    <script src="~/js/panigation.js"></script>

    <link href="~/css/DatetimePicker.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/js/DatetimePicker-IU.js" asp-append-version="true"></script>
    <script src="~/js/DatetimePicker.js" asp-append-version="true"></script>
    <link href="~/css/TableSort.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/js/TableSort.js" asp-append-version="true"></script>
    <script src="~/js/prod-capacity.js" asp-append-version="true"></script>
}
