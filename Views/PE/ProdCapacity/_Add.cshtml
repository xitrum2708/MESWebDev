@using MESWebDev.Models.PE
@model ProdCapacityModel

<form asp-controller="PE" asp-action="AddProdCapacity" method="post" id="addCapacityForm">
    @Html.AntiForgeryToken()
    <div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addCapacityLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div id="capacityUploadError"
                 class="alert alert-danger d-none"
                 role="alert">
            </div>
            <div class="modal-content">
                <div class="modal-header capacity-modal-header">
                    <h5 class="modal-title" id="addCapacityLabel"><i class="bi bi-plus-circle me-2"></i>Add Production Capacity</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 pb-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <partial name="ProdCapacity/_Fields" model="@Model" />
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-circle me-1"></i>Save</button>
                </div>
            </div>
        </div>
    </div>
</form>
